#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
export DEBIAN_FRONTEND=noninteractive
toolchains="$HOME/.local/share/goodflows"
export PATH="$toolchains/elixir-1.19.4/bin:$toolchains/otp-28.1.1/bin:$HOME/.cargo/bin:$PATH"
export HEX_CACERTS_PATH=/etc/ssl/certs/ca-certificates.crt
TIMEFORMAT='  completed in %3R seconds'

echo 'Installing missing system packages'
packages=(build-essential ca-certificates curl unzip libssl3 libncurses6 postgresql-15 postgresql-contrib)
missing=()
for package in "${packages[@]}"; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
    missing+=("$package")
  fi
done
if ((${#missing[@]})); then
  time sudo apt-get update -qq
  time sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi

echo 'Preparing Elixir 1.19.4, OTP 28.1.1 and Rust 1.90.0'
# Hex's Ubuntu 22.04 builds use the same OpenSSL 3 / ncurses 6 ABI as Debian 12.
otp_home="$toolchains/otp-28.1.1"
if [[ ! -x "$otp_home/bin/erl" ]]; then
  archive=$(mktemp)
  curl --fail --location --retry 3 --silent --show-error \
    https://builds.hex.pm/builds/otp/amd64/ubuntu-22.04/OTP-28.1.1.tar.gz -o "$archive"
  echo "3b679d2be2600e55d05a6beaa6735169b35bb1e18e6b97de28273507bde98744  $archive" | sha256sum -c -
  mkdir -p "$otp_home"
  tar -xzf "$archive" -C "$otp_home" --strip-components=1
  "$otp_home/Install" -minimal "$otp_home"
  rm -f "$archive"
fi
elixir_home="$toolchains/elixir-1.19.4"
if [[ ! -x "$elixir_home/bin/elixir" ]]; then
  archive=$(mktemp)
  curl --fail --location --retry 3 --silent --show-error \
    https://builds.hex.pm/builds/elixir/v1.19.4-otp-28.zip -o "$archive"
  mkdir -p "$elixir_home"
  unzip -q -o "$archive" -d "$elixir_home"
  rm -f "$archive"
fi
if ! command -v rustup >/dev/null; then
  curl --proto '=https' --tlsv1.2 --fail --silent --show-error https://sh.rustup.rs | \
    sh -s -- -y --no-modify-path --profile minimal --default-toolchain 1.90.0
fi
time rustup toolchain install 1.90.0 --profile minimal --component rustfmt --component clippy
rustup default 1.90.0

# Amp and supervised services use separate login shells, not this setup shell.
cat > "$toolchains/env" <<'ENV'
export PATH="$HOME/.local/share/goodflows/elixir-1.19.4/bin:$HOME/.local/share/goodflows/otp-28.1.1/bin:$HOME/.cargo/bin:$PATH"
export HEX_CACERTS_PATH=/etc/ssl/certs/ca-certificates.crt
ENV
profile_marker='# GoodFlows orb toolchains'
touch "$HOME/.bash_profile"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile"; then
  cat >> "$HOME/.bash_profile" <<'PROFILE'

# GoodFlows orb toolchains
source "$HOME/.local/share/goodflows/env"
PROFILE
fi

echo 'Fetching locked Mix dependencies'
cd app
if ! compgen -G "$HOME/.mix/archives/hex-*" >/dev/null; then
  time mix local.hex --force
fi
if [[ ! -f "$HOME/.mix/elixir/1-19-otp-28/rebar3" ]]; then
  time mix local.rebar --force
fi
time mix deps.get --check-locked

echo 'Warming development and test builds and asset tools'
time mix compile
time mix assets.setup
time mix assets.build
time env MIX_ENV=test mix compile
time cargo build --locked --manifest-path ../sprite-transfer/Cargo.toml

echo 'Preparing local PostgreSQL development and test databases'
# Only this disposable orb's cluster is tuned for speed over crash durability.
sudo tee /etc/postgresql/15/main/conf.d/goodflows-orb.conf >/dev/null <<'POSTGRES'
fsync = off
synchronous_commit = off
full_page_writes = off
POSTGRES
started_postgres=false
if ! pg_isready -q -h localhost -p 5432; then
  sudo pg_ctlcluster 15 main start
  started_postgres=true
fi
# Setup daemons do not survive snapshotting; resume restores the supervised DB.
trap 'if $started_postgres; then sudo pg_ctlcluster 15 main stop; fi' EXIT
sudo -u postgres psql -v ON_ERROR_STOP=1 -c "ALTER USER postgres PASSWORD 'postgres'" >/dev/null
time mix ecto.create
time mix ecto.migrate
time mix run priv/repo/seeds.exs
time env MIX_ENV=test mix ecto.create
time env MIX_ENV=test mix ecto.migrate

echo 'GoodFlows orb setup ready'
