<div id="dashboard-layout" class="flex min-h-screen bg-base-100">
  <aside
    id="sidebar"
    class="sidebar inset-y-0 left-0 z-50 flex w-72 shrink-0 flex-col lg:sticky lg:top-0 lg:h-screen lg:w-60"
    phx-window-keydown={hide_mobile_sidebar()}
    phx-key="Escape"
  >
    <.sidebar_content
      active_nav={assigns[:active_nav]}
      current_scope={@current_scope}
      current_account={assigns[:current_account]}
    />
  </aside>

  <div
    class="sidebar-backdrop fixed inset-0 z-40"
    aria-hidden="true"
    phx-click={hide_mobile_sidebar()}
  >
  </div>

  <div class="flex min-w-0 flex-1 flex-col">
    <header class="sticky top-0 z-30 flex h-14 items-center justify-between gap-3 border-b border-base-300/50 bg-base-100 px-4 lg:h-11">
      <div class="flex min-w-0 items-center gap-3">
        <button
          type="button"
          class="-ml-2 rounded-sm p-2 text-base-content hover:bg-base-200 lg:hidden"
          phx-click={show_mobile_sidebar()}
          aria-label="Open menu"
        >
          <.icon name="hero-bars-3" class="size-6" />
        </button>
        <.breadcrumbs items={
          assigns[:breadcrumbs] || [%{label: assigns[:page_title] || "Dashboard"}]
        } />
      </div>

      <div class="flex shrink-0 items-center gap-3">
        <.theme_toggle />

        <.menu
          label="Your account"
          position="end"
          trigger_class="gap-1.5 px-1.5 py-1 font-mono text-xs text-muted hover:text-base-content"
          panel_class="z-20 mt-1 w-52"
        >
          <:trigger>
            <.icon name="hero-user-circle-mini" class="size-4 sm:hidden" />
            <span class="hidden max-w-56 truncate sm:block">{@current_scope.user.email}</span>
            <.icon name="hero-chevron-down-micro" class="size-3.5" />
          </:trigger>
          <li class="truncate px-2.5 py-2 font-mono text-xs text-muted sm:hidden">
            {@current_scope.user.email}
          </li>
          <li>
            <.link href={~p"/users/settings"} class="menu-item">
              <.icon name="hero-cog-6-tooth-mini" class="size-4 text-muted" /> Settings
            </.link>
          </li>
          <li>
            <.link href={~p"/users/log-out"} method="delete" class="menu-item">
              <.icon name="hero-arrow-right-start-on-rectangle-mini" class="size-4 text-muted" />
              Log out
            </.link>
          </li>
        </.menu>
      </div>
    </header>

    <main id="main" tabindex="-1" class="bg-grid flex-1 p-4 lg:p-6">
      {@inner_content}
    </main>
  </div>
</div>

<.flash_group flash={@flash} />
