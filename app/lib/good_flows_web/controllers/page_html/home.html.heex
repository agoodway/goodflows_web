<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section id="home-hero" class="space-y-6 py-4 sm:py-8">
    <h1 class="text-3xl font-semibold tracking-tight text-base-content sm:text-4xl">
      Your checks, defined once and run with one command
    </h1>
    <p class="max-w-xl text-base text-muted">
      List the jobs in <code class="text-base-content">goodflows.toml</code>.
      GoodFlows runs them in dependency order and keeps the runs, test reports
      and change reviews for each project.
    </p>

    <div class="space-y-2">
      <.code_block title="goodflows.toml">
        <:source phx-no-format>[[workflows.ci.jobs]]
name = "compile"
command = "mix compile --warnings-as-errors"

[[workflows.ci.jobs]]
name = "test"
command = "mix test"
depends_on = ["compile"]</:source>
      </.code_block>
      <.code_block>
        <:line>goodflows run ci</:line>
      </.code_block>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= if @current_scope do %>
        <.button id="home-dashboard-link" href={~p"/dashboard"} variant="primary">
          Go to dashboard
        </.button>
      <% else %>
        <.button id="home-login-link" navigate={~p"/users/log-in"} variant="primary">
          Log in
        </.button>
        <.button id="home-register-link" navigate={~p"/users/register"}>
          Create an account
        </.button>
      <% end %>
      <.button href={~p"/api/v1/docs"} variant="ghost">API reference</.button>
    </div>
  </section>
</Layouts.app>
