up:
  bash scripts/start_dev.sh

port:
  @bash scripts/dev_port.sh

# Local MinIO for remote caches (foreground); prints the CACHE_S3_* settings.
minio:
  bash scripts/minio.sh

install:
    mix deps.get
    mix assets.setup

deploy:

test:
    mix test

test-scripts:
    python3 -m unittest discover -s scripts/tests

build:
    mix compile

clean:
    mix clean
    rm -rf _build deps

# Sync .env.prod to Fly secrets (dry-run by default, pass --execute to apply)
fly-secrets *args:
    ./scripts/env-to-fly-secrets.sh -f .env.prod {{args}}
