#!/bin/sh
# Sourced by the release scripts (bin/good_flows) before the VM starts.
#
# Spry run owner ids embed the node name, and the reaper uses it to find and
# stop a run's worker. Nodes must therefore be distributed with a name that
# is stable across restarts and unique in the cluster, and production refuses
# to start PgFlow workers on an undistributed :nonode@nohost
# (GoodFlows.Spry.Config.validate!/0).
#
# Override either variable in the environment; see .env.sample.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"

# On Fly.io the hostname is the bare machine ID, which is not a long name.
# The machine's 6PN DNS name keeps its ID across restarts and deploys, and
# resolves only over IPv6.
if [ -n "${FLY_MACHINE_ID}" ] && [ -z "${RELEASE_HOST}" ]; then
  RELEASE_HOST="${FLY_MACHINE_ID}.vm.${FLY_APP_NAME}.internal"
  export ERL_AFLAGS="-proto_dist inet6_tcp ${ERL_AFLAGS:-}"
fi

if [ -z "${RELEASE_NODE}" ]; then
  RELEASE_HOST="${RELEASE_HOST:-$(hostname -f 2>/dev/null || hostname)}"
  export RELEASE_NODE="<%= @release.name %>@${RELEASE_HOST}"
fi

# Without RELEASE_COOKIE the release script falls back to releases/COOKIE,
# which `mix release` generates at build time. Every copy of a published image
# has that file, and anyone who knows a node's cookie and can reach its
# distribution port can run code on it. So a command that starts or connects
# to a distributed node needs RELEASE_COOKIE from the environment.
#
# `eval` (bin/migrate) and `version` never start distribution, so they run
# without one, as does every command under RELEASE_DISTRIBUTION=none.
case "${RELEASE_COMMAND}" in
  eval | version) ;;
  *)
    if [ "${RELEASE_DISTRIBUTION}" != "none" ] && [ -z "${RELEASE_COOKIE}" ]; then
      echo "ERROR: RELEASE_COOKIE is not set." >&2
      echo "The cookie built into this release is the same in every copy of the image, so it is never used for a distributed node." >&2
      echo "Set RELEASE_COOKIE to a long random secret, the same on every node of the cluster. Generate one with: openssl rand -hex 32" >&2
      exit 1
    fi
    ;;
esac
