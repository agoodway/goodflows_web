# GoodFlows Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Phoenix Server
PHX_SERVER=true
# Public hostname for emails, magic links, and OAuth issuer.
# Local: localhost. Sprite: host from `sprite info` / `sprite url` (no scheme).
PHX_HOST=localhost
# PHX_SCHEME=https
# PHX_URL_PORT=443
PORT=4000

# Database
DATABASE_URL=ecto://postgres:postgres@localhost/good_flows_dev
POOL_SIZE=10
ECTO_IPV6=false

# Security (generate with: mix phx.gen.secret)
SECRET_KEY_BASE=

# Encryption key for secrets stored at rest (Sprites tokens). Required in production.
# Generate with: elixir -e 'IO.puts(:crypto.strong_rand_bytes(32) |> Base.encode64())'
CLOAK_KEY=

# DNS Cluster (optional, for production clustering)
DNS_CLUSTER_QUERY=

# Erlang distribution for releases (read by rel/env.sh.eex). Spry run owner
# ids embed the node name, so production nodes must be distributed with a
# name that is stable across restarts and unique in the cluster; production
# refuses to start Spry workers on an undistributed node.
# RELEASE_DISTRIBUTION defaults to "name"; RELEASE_NODE defaults to
# good_flows@<RELEASE_HOST or `hostname -f`>.
RELEASE_DISTRIBUTION=name
RELEASE_NODE=
# RELEASE_HOST=
# RELEASE_COOKIE=

# Spry: maximum concurrent runs per node (PgFlow worker max_concurrency).
SPRY_RUN_MAX_CONCURRENCY=10

# Test report uploads (POST /api/v1/projects/:project/test-reports).
# Body limit in bytes (32 MiB).
TEST_REPORT_MAX_BODY_BYTES=33554432
# Concurrent uploads per node (read, decode, validation and persistence);
# must be at most half of POOL_SIZE.
TEST_REPORT_MAX_CONCURRENT_UPLOADS=2
# Concurrent uploads per account on one node.
TEST_REPORT_MAX_CONCURRENT_UPLOADS_PER_ACCOUNT=1
# Overall deadline for receiving one upload body (408 when exceeded).
TEST_REPORT_READ_TIMEOUT_MS=60000
# Heap limit of a request process while it holds an upload slot (2 GiB).
TEST_REPORT_MAX_HEAP_BYTES=2147483648
# Timeout of the test report insert and comparison queries.
TEST_REPORT_DB_TIMEOUT_MS=15000

# Sprite pools (GoodFlows.Pools.Config documents every setting; defaults shown).
# Only the settings below come from the environment; the transfer tuning
# (ack timeout, attempts, backoff), helper idle timeout, report fetch wait and
# file count, and the reconcile, heartbeat, and owner RPC intervals are
# config-only (config :good_flows, GoodFlows.Pools).
# Off switch: no member is granted or provisioned and pool routes answer 503
# (except pool deletion); sessions still expire and members are still reset
# and destroyed, so a rollback cleans up. In production a missing or invalid
# priv/gf-transfer/manifest.json stops the node at boot while this is true
# (run sprite-transfer/scripts/package.sh before `mix release`).
POOLS_ENABLED=true
POOL_MAX_MEMBERS_CAP=32
# Budget for provisioning one member (setup, helper install, checkpoint). At
# most 2100000 (35 min): the provision job's fixed 40-minute hard timeout must
# cover it plus 5 minutes of margin, or the node refuses to boot.
POOL_PROVISION_TIMEOUT_MS=1800000
POOL_WORKSPACE_MAX_BYTES=268435456
POOL_WORKSPACE_MAX_EXPANDED_BYTES=2147483648
POOL_WORKSPACE_MAX_ENTRIES=100000
POOL_ARCHIVE_VALIDATION_TIMEOUT_MS=60000
# The helper's validation + extraction budget inside each member.
POOL_HELPER_EXTRACT_TIMEOUT_MS=300000
POOL_WORKSPACE_READ_TIMEOUT_MS=300000
POOL_WORKSPACE_MAX_CONCURRENT_UPLOADS_PER_ACCOUNT=1
# Helper protocol chunk size (at most 1048576) and node-wide active transfers.
POOL_TRANSFER_CHUNK_BYTES=1048576
POOL_TRANSFER_CONCURRENCY=2
# Node-local spool (defaults to goodflows-pools under the system temp dir).
# POOL_SPOOL_DIR=
POOL_SPOOL_MAX_BYTES=2147483648
# One account's share of a node's spool (uploads and report downloads); at
# least POOL_WORKSPACE_MAX_BYTES.
POOL_SPOOL_ACCOUNT_MAX_BYTES=1073741824
# POOL_HELPER_ARTIFACT_DIR=
# Secret keying credential fingerprints (defaults to SECRET_KEY_BASE). Pin it
# to the old value before rotating SECRET_KEY_BASE, or every pool rebuilds.
# POOL_FINGERPRINT_SECRET=
POOL_DISCONNECT_GRACE_MS=60000
POOL_MAX_SESSION_LIFETIME_MS=21600000
POOL_ACQUIRE_TIMEOUT_MAX_MS=600000
POOL_EXEC_MAX_MS=3600000
POOL_EXEC_BUFFER_BYTES=1048576
# Ended sessions and their execs are deleted after this long (30 days).
POOL_SESSION_RETENTION_MS=2592000000
# PgFlow worker concurrency per node for member jobs.
POOL_PROVISION_MAX_CONCURRENCY=4
POOL_RESET_MAX_CONCURRENCY=4
POOL_DESTROY_MAX_CONCURRENCY=2

# Feature Flags
ENABLE_BETA_FEATURES=false
MAINTENANCE_MODE=false

# Monitoring (optional)
SENTRY_DSN=
HONEYBADGER_API_KEY=

# Mailer Configuration (Development)
# For development, emails are logged by default
MAIL_FROM=noreply@example.com

# CORS (production): comma-separated browser origins allowed to call /api/v1
CORS_ORIGINS=
