# GoodFlows Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Phoenix Server
PHX_SERVER=true
# Public hostname for emails, magic links, and OAuth issuer.
# Local: localhost. Sprite: host from `sprite info` / `sprite url` (no scheme).
PHX_HOST=localhost
# PHX_SCHEME=https
# PHX_URL_PORT=443
# Main checkout. A worktree sets its own PORT in .env.dev.local.
PORT=7654

# Database
DATABASE_URL=ecto://postgres:postgres@localhost/good_flows_dev
POOL_SIZE=10
ECTO_IPV6=false
ECTO_SSL=false

# Security (generate with: mix phx.gen.secret)
SECRET_KEY_BASE=

# Encryption key for secrets stored at rest (Sprites tokens). Required in production.
# Generate with: elixir -e 'IO.puts(:crypto.strong_rand_bytes(32) |> Base.encode64())'
CLOAK_KEY=

# DNS Cluster (optional, for production clustering)
DNS_CLUSTER_QUERY=

# Erlang distribution for releases (read by rel/env.sh.eex). Spry run owner
# ids embed the node name, so production nodes must be distributed with a
# name that is stable across restarts and unique in the cluster; production
# refuses to start Spry workers on an undistributed node.
# RELEASE_DISTRIBUTION defaults to "name"; RELEASE_NODE defaults to
# good_flows@<RELEASE_HOST or `hostname -f`>.
RELEASE_DISTRIBUTION=name
RELEASE_NODE=
# RELEASE_HOST=
# Erlang distribution cookie. Required to start a release: the cookie built
# into the image is the same in every copy, so rel/env.sh.eex refuses to start
# a distributed node without this. Use the same value on every node of a
# cluster. Generate with: openssl rand -hex 32
RELEASE_COOKIE=

# Spry: maximum concurrent runs per node (PgFlow worker max_concurrency).
SPRY_RUN_MAX_CONCURRENCY=10

# Test report uploads (POST /api/v1/projects/:project/test-reports).
# Body limit in bytes (32 MiB).
TEST_REPORT_MAX_BODY_BYTES=33554432
# Concurrent uploads per node (read, decode, validation and persistence);
# must be at most half of POOL_SIZE.
TEST_REPORT_MAX_CONCURRENT_UPLOADS=2
# Concurrent uploads per account on one node.
TEST_REPORT_MAX_CONCURRENT_UPLOADS_PER_ACCOUNT=1
# Overall deadline for receiving one upload body (408 when exceeded).
TEST_REPORT_READ_TIMEOUT_MS=60000
# Heap limit of a request process while it holds an upload slot (2 GiB).
TEST_REPORT_MAX_HEAP_BYTES=2147483648
# Timeout of the test report insert and comparison queries.
TEST_REPORT_DB_TIMEOUT_MS=15000
# Workflow run uploads (POST /api/v1/projects/:project/workflow-runs).
# Body limit in bytes (4 MiB).
WORKFLOW_RUN_MAX_BODY_BYTES=4194304
# Overall deadline for receiving one upload body (408 when exceeded).
WORKFLOW_RUN_READ_TIMEOUT_MS=30000
# Timeout of the workflow run insert and comparison queries.
WORKFLOW_RUN_DB_TIMEOUT_MS=15000

# Monitoring (optional)
SENTRY_DSN=

# Postmark mailer adapter (production; dev uses the local /dev/mailbox)
POSTMARK_API_KEY=

# Required in production (sender email for system mail)
MAILER_FROM_EMAIL=noreply@example.com

# Optional (defaults to GoodFlows)
MAILER_FROM_NAME=GoodFlows

# CORS (production): comma-separated browser origins allowed to call /api/v1
CORS_ORIGINS=

# Remote cache storage (/api/v1/projects/:project/caches). Caches are disabled
# (cache routes respond 503) until CACHE_S3_BUCKET is set. Production uses
# Cloudflare R2: endpoint https://<account>.r2.cloudflarestorage.com, region
# auto, and an R2 API token scoped to the bucket. Omit the endpoint for AWS S3.
# Local MinIO: `just minio` in app/ prints the values to use.
CACHE_S3_BUCKET=
CACHE_S3_ENDPOINT=
CACHE_S3_REGION=auto
# Required when CACHE_S3_BUCKET is set: the server refuses to boot without them.
CACHE_S3_ACCESS_KEY_ID=
CACHE_S3_SECRET_ACCESS_KEY=
# Largest entry in bytes. The server refuses to boot above 5363466240 (R2's
# single-request upload limit) or above CACHE_PROJECT_QUOTA_BYTES.
CACHE_MAX_ENTRY_BYTES=5000000000
# Per-project byte quota (50 GiB) and entry cap, counting committed entries
# and unexpired reservations. A reservation that does not fit evicts the
# least recently used entries.
CACHE_PROJECT_QUOTA_BYTES=53687091200
CACHE_PROJECT_MAX_ENTRIES=10000
# Most active (neither revoked nor expired) cache keys a project may hold;
# minting one more responds 422.
CACHE_MAX_KEYS_PER_PROJECT=1000
# Entries not restored for this many days are deleted by the sweep.
CACHE_RETENTION_DAYS=7
# Reservation lifetime, and presigned upload and download URL lifetimes. The
# server refuses to boot when the upload URL lifetime is above the
# reservation lifetime, or the reservation lifetime is above 604800 (a week,
# the longest a presigned URL lasts; multipart part URLs expire with the
# reservation).
CACHE_RESERVATION_TTL_SECONDS=7200
CACHE_UPLOAD_URL_TTL_SECONDS=900
CACHE_DOWNLOAD_URL_TTL_SECONDS=900
