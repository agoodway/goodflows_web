# GoodFlows Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Phoenix Server
PHX_SERVER=true
# Public hostname for emails, magic links, and OAuth issuer.
# Local: localhost. Sprite: host from `sprite info` / `sprite url` (no scheme).
PHX_HOST=localhost
# PHX_SCHEME=https
# PHX_URL_PORT=443
PORT=4000

# Database
DATABASE_URL=ecto://postgres:postgres@localhost/good_flows_dev
POOL_SIZE=10
ECTO_IPV6=false

# Security (generate with: mix phx.gen.secret)
SECRET_KEY_BASE=

# Encryption key for secrets stored at rest (Sprites tokens). Required in production.
# Generate with: elixir -e 'IO.puts(:crypto.strong_rand_bytes(32) |> Base.encode64())'
CLOAK_KEY=

# DNS Cluster (optional, for production clustering)
DNS_CLUSTER_QUERY=

# Erlang distribution for releases (read by rel/env.sh.eex). Spry run owner
# ids embed the node name, so production nodes must be distributed with a
# name that is stable across restarts and unique in the cluster; production
# refuses to start Spry workers on an undistributed node.
# RELEASE_DISTRIBUTION defaults to "name"; RELEASE_NODE defaults to
# good_flows@<RELEASE_HOST or `hostname -f`>.
RELEASE_DISTRIBUTION=name
RELEASE_NODE=
# RELEASE_HOST=
# RELEASE_COOKIE=

# Spry: maximum concurrent runs per node (PgFlow worker max_concurrency).
SPRY_RUN_MAX_CONCURRENCY=10

# Test report uploads (POST /api/v1/projects/:project/test-reports).
# Body limit in bytes (32 MiB).
TEST_REPORT_MAX_BODY_BYTES=33554432
# Concurrent uploads per node (read, decode, validation and persistence);
# must be at most half of POOL_SIZE.
TEST_REPORT_MAX_CONCURRENT_UPLOADS=2
# Concurrent uploads per account on one node.
TEST_REPORT_MAX_CONCURRENT_UPLOADS_PER_ACCOUNT=1
# Overall deadline for receiving one upload body (408 when exceeded).
TEST_REPORT_READ_TIMEOUT_MS=60000
# Heap limit of a request process while it holds an upload slot (2 GiB).
TEST_REPORT_MAX_HEAP_BYTES=2147483648
# Timeout of the test report insert and comparison queries.
TEST_REPORT_DB_TIMEOUT_MS=15000
# Timeout of the workflow run insert and comparison queries.
WORKFLOW_RUN_DB_TIMEOUT_MS=15000

# Feature Flags
ENABLE_BETA_FEATURES=false
MAINTENANCE_MODE=false

# Monitoring (optional)
SENTRY_DSN=
HONEYBADGER_API_KEY=

# Mailer Configuration (Development)
# For development, emails are logged by default
MAIL_FROM=noreply@example.com

# CORS (production): comma-separated browser origins allowed to call /api/v1
CORS_ORIGINS=
